# ── Copy this file to .env and fill in your values ───────────────────────────

# ── Gmail (שליחת מייל יומי) ───────────────────────────────────────────────────
GMAIL_USER=roeeeng@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx    # App Password מ-Google (16 תווים)
EMAIL_TO=roeeeng@gmail.com

# ── Schedule ──────────────────────────────────────────────────────────────────
DAILY_RUN_TIME=08:00               # שעון ישראל
SEND_IF_NO_NEWS=false

# ── Filters ───────────────────────────────────────────────────────────────────
MIN_POSITION_VALUE=5000            # מינימום $5M לפוזיציה
MIN_CHANGE_PCT=20.0                # מינימום 20% שינוי לדיווח
