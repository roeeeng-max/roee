# ── Copy this file to .env and fill in your values ───────────────────────────

# ── CallMeBot WhatsApp (free) ─────────────────────────────────────────────────
# Step 1: Add +34 644 47 62 26 to your WhatsApp contacts
# Step 2: Send it the message:  I allow callmebot to send me messages
# Step 3: You will receive an API key — paste it below
CALLMEBOT_PHONE=+972501234567      # Your WhatsApp number with country code
CALLMEBOT_APIKEY=1234567           # The key you received from CallMeBot

# ── Schedule ──────────────────────────────────────────────────────────────────
DAILY_RUN_TIME=08:00               # 24h, Israel time (UTC+3)
SEND_IF_NO_NEWS=false              # true = send even when nothing new

# ── Filters ───────────────────────────────────────────────────────────────────
MIN_POSITION_VALUE=5000            # Min position size in thousands USD ($5M)
MIN_CHANGE_PCT=20.0                # Min % change to include in report
