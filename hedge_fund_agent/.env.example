# ── Copy this file to .env and fill in your values ───────────────────────────

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp Sandbox number (leave as-is for Twilio Sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp number (include country code, no spaces)
WHATSAPP_TO=whatsapp:+972501234567

# Time to send the daily update (24h, Israel time)
DAILY_RUN_TIME=08:00

# Send a message even when there are no updates? (true/false)
SEND_IF_NO_NEWS=false

# Minimum position size to include in reports (in thousands USD)
# 5000 = $5M
MIN_POSITION_VALUE=5000

# Minimum % change to report (20 = 20%)
MIN_CHANGE_PCT=20.0
